generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Salon {
  id             Int     @id @default(1)
  name           String  
  description    String  @default("")
  address        String  @default("")
  phone          String  @default("")
  email          String  @default("")
  logoUrl        String?  
  mapEmbedUrl    String?  
  accentColor    String  @default("#b4543a")
  cancelHours    Int     @default(12)
  maxAdvanceDays Int     @default(30)
  minLeadMin     Int     @default(60)
  defaultStepMin Int     @default(30)
  timezone       String  @default("Europe/Belgrade")
  emailTemplates String @default("{}")
}

model User {
  id           Int     @id @default(autoincrement())
  email        String  @unique
  passwordHash String  
  role         String  @default("admin")
  stylistId    Int?
}

model Stylist {
  id           Int           @id @default(autoincrement())
  name         String  
  photoUrl     String?
  bio          String        @default("")
  active       Boolean       @default(true)
  services     StylistService[]
  hours        WorkingHours[]
  timeOff      TimeOff[]
  appointments Appointment[]
}

model ServiceCategory {
  id        Int       @id @default(autoincrement())
  name      String  
  sortOrder Int       @default(0)
  services  Service[]
}

model Service {
  id          Int             @id @default(autoincrement())
  categoryId  Int  
  category    ServiceCategory @relation(fields: [categoryId], references: [id])
  name        String  
  description String          @default("")
  durationMin Int  
  priceRsd    Int  
  stepMin     Int             @default(30)
  active      Boolean         @default(true)
  stylists    StylistService[]
}

model StylistService {
  stylistId Int  
  serviceId Int  
  priceRsd  Int?      
  stylist   Stylist @relation(fields: [stylistId], references: [id], onDelete: Cascade)
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  @@id([stylistId, serviceId])
}

model WorkingHours {
  id            Int      @id @default(autoincrement())
  stylistId     Int?  
  stylist       Stylist? @relation(fields: [stylistId], references: [id], onDelete: Cascade)
  weekday       Int  
  startMin      Int  
  endMin        Int  
  breakStartMin Int?  
  breakEndMin   Int?
}

model TimeOff {
  id        Int      @id @default(autoincrement())
  stylistId Int?  
  stylist   Stylist? @relation(fields: [stylistId], references: [id], onDelete: Cascade)
  startsAt  DateTime  
  endsAt    DateTime  
  reason    String   @default("")
}

model Holiday {
  id   Int    @id @default(autoincrement())
  date String @unique 
  name String @default("")
}

model Customer {
  id           Int           @id @default(autoincrement())
  name         String  
  phone        String        @unique 
  email        String?  
  note         String        @default("")
  appointments Appointment[]
}

model Appointment {
  id               Int                  @id @default(autoincrement())
  customerId       Int  
  customer         Customer             @relation(fields: [customerId], references: [id])
  stylistId        Int  
  stylist          Stylist              @relation(fields: [stylistId], references: [id])
  status           String               @default("zakazan") 
  startsAt         DateTime  
  endsAt           DateTime  
  totalPriceRsd    Int  
  totalDurationMin Int  
  manageToken      String               @unique  
  shortCode        String   
  source           String               @default("online") 
  note             String               @default("")
  reminderSent     Boolean              @default(false)
  createdAt        DateTime             @default(now())
  items            AppointmentService[]  
  @@index([stylistId, startsAt])
}

model AppointmentService {
  id            Int         @id @default(autoincrement())
  appointmentId Int  
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  serviceId     Int  
  nameSnapshot  String  
  priceRsd      Int  
  durationMin   Int
}
model Image {
  id        String   @id
  mime      String
  data      Bytes
  createdAt DateTime @default(now())
}